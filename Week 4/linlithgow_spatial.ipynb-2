      "source": [
        "# Try and do the same thing for burials that are earlier than 1500\n",
        "linlithgow_burials.loc[(linlithgow_burials['LATEST_DATE']<=1500) & (linlithgow_burials['LATEST_DATE'] >= 1400)]"
      ]
    },
